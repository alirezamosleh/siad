# --- سرور و اپلیکیشن ---
APP_NAME="Moodle FastAPI Auth Service"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# --- آدرس‌های مودل و سرویس لاگین ---
# آدرس اصلی سایت مودل شما
MOODLE_URL="https://lms.youruniversity.ac.ir"
# آدرس عمومی همین سرویس لاگین (برای redirect_uriهای USW)
AUTH_SERVICE_URL="https://auth.youruniversity.ac.ir"

# کلید مشترک بین مودل و FastAPI برای امضای SSO Ticket (یک رشته طولانی و تصادفی بسازید)
# مقدار یکسان در تنظیمات پلاگین auth_sadaa مودل نیز باید وارد شود
SSO_SECRET="change-this-to-a-super-secret-random-key-at-least-32-chars-long"
SSO_TOKEN_TTL_SECONDS=60

# --- تنظیمات اتصال به دیتابیس مودل (MariaDB / MySQL بیتنامی) ---
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="bitnami_moodle"
DB_USER="bn_moodle"
DB_PASSWORD="your_db_password"
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50
# پیشوند جداول مودل (معمولاً mdl_)
DB_PREFIX="mdl_"

# --- تنظیمات احراز هویت USW (وزارت علوم / پنجره واحد دولت من) ---
USW_ENABLED=True
USW_CLIENT_ID="your_usw_client_id"
USW_CLIENT_SECRET="your_usw_client_secret"
USW_AUTHORIZE_URL="https://usw.msrt.ir/oauth2/authorize"
USW_TOKEN_URL="https://usw.msrt.ir/oauth2/token"
USW_USERINFO_URL="https://usw.msrt.ir/api/v1/User/userinfo"
USW_REDIRECT_URI="https://auth.youruniversity.ac.ir/auth/usw/callback"
# آیا کاربر جدید ساخته شود در صورتی که در مودل نبود؟
USW_AUTO_CREATE_USER=True

# --- فیلد پروفایل کد ملی در مودل ---
# نام کوتاه فیلد سفارشی که در مودل ساخته‌اید (Site Admin -> Users -> User profile fields)
NATIONAL_ID_FIELD="nationalid"

# --- تنظیمات ارسال ایمیل فراموشی رمز عبور (SMTP غیرهمگام) ---
SMTP_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@youruniversity.ac.ir"
SMTP_PASSWORD="your_smtp_app_password"
SMTP_FROM_EMAIL="notifications@youruniversity.ac.ir"
SMTP_USE_TLS=True
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
