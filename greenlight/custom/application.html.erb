<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <title>پرتال وبینار دانشگاه هدی</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta property="og:title" content="<%= page_title %>" />
    <meta property="og:description" content="<%= t('opengraph.description') %>" />
    <meta property="og:image" content="<%= branding_image %>" />

    <link rel="icon" type="image/png" href="/hoda-favicon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <link rel="stylesheet" href="/hoda-theme.css">
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/rooms.css">
    <link rel="stylesheet" href="/styles/auth.css">
    <link rel="stylesheet" href="/styles/recordings.css">
    <link rel="stylesheet" href="/custom-overrides.css">
    <script src="/rtl-fix.js"></script>
    <%# Local Hoda React bundle — built from custom/react (NOT stock precompiled main) %>
    <script src="/styles/hoda-main.js" defer></script>
  </head>
  <body dir="rtl">
    <%= yield %>
  </body>
</html>
