# ==============================================================================
# پرونده جامع متغیرهای محیطی سامانه یکپارچه یادگیری و وبینار
# (مودل بومی PHP-FPM + گرین‌لایت ۳ + سرویس احراز هویت هوشمند FastAPI + Nginx)
# Unified Master Environment Configuration for Siad Stack
# ==============================================================================

# ==============================================================================
# ۱. تنظیمات عمومی و محیط اجرا (ENVIRONMENT)
# ==============================================================================
# مقدار local برای اجرای لوکال با پورت‌های مجزا و بدون نیاز به هاست/دامنه
# مقدار production برای استقرار روی سرور اصلی با دامنه‌های رسمی و SSL
ENVIRONMENT=local

# ==============================================================================
# ۲. درگاه معکوس NGINX و پورت‌های سرور
# ==============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MOODLE_PORT=8080
AUTH_PORT=8016
GREENLIGHT_PORT=3000

# ==============================================================================
# ۳. پایگاه داده اصلی مودل و احراز هویت (MariaDB 11.2)
# ==============================================================================
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=siad
DB_USER=alirezabb
DB_PASSWORD=SEDO3482389D4
DB_PREFIX=mdl_
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50

# تنظیمات کانتینر MariaDB (جهت تغذیه با env_file):
MARIADB_ROOT_PASSWORD=SEDO3482389D4
MARIADB_USER=alirezabb
MARIADB_PASSWORD=SEDO3482389D4
MARIADB_DATABASE=siad
MARIADB_LOG_QUERIES=OFF

# ==============================================================================
# ۴. حافظه نهان و نشست‌های مودل (Redis)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kali

# ==============================================================================
# ۵. تنظیمات مودل (Moodle 4.5 با PHP 8.2-FPM)
# ==============================================================================
# برای محیط لوکال:
MOODLE_HOST=localhost:8080
MOODLE_URL=http://localhost:8080
MOODLE_REVERSEPROXY=no
MOODLE_SSLPROXY=no

# برای سرور پروداکشن (در سرور این ۴ خط را از کامنت خارج کنید):
# MOODLE_HOST=siad.hu.jz.ac.ir
# MOODLE_URL=https://siad.hu.jz.ac.ir
# MOODLE_REVERSEPROXY=yes
# MOODLE_SSLPROXY=yes

MOODLE_DATAROOT=/var/moodledata
MOODLE_ADMIN_USER=admin1
MOODLE_ADMIN_PASSWORD=N.mosleh63@
MOODLE_ADMIN_EMAIL=work.alirezamosleh@gmail.com
MOODLE_SITE_NAME=سامانه یادگیری سیاد

# ==============================================================================
# ۶. سرویس احراز هویت هوشمند و ورود یکپارچه (FastAPI Smart SSO & Auth)
# ==============================================================================
APP_NAME=سامانه ورود یکپارچه المصطفی (سیاد)
DEBUG=False
# پورت پیش‌فرض گرین‌لایت (Puma):
PORT=3000
HOST=0.0.0.0

# آدرس عمومی سرویس احراز هویت:
AUTH_SERVICE_URL=http://localhost:8016
# برای پروداکشن:
# AUTH_SERVICE_URL=https://auth.siad.hu.jz.ac.ir

# کلید مشترک رمزنگاری متقارن بلیت‌های ورود (Shared Secret Ticket JWT)
SSO_SECRET=siad-hu-jz-ac-ir-super-secret-sso-key-2026-xyz
SSO_TOKEN_TTL_SECONDS=120

# مشخصات استاندارد OAuth 2.0 / OpenID Connect برای اتصال رسمی به مودل:
OAUTH_CLIENT_ID=moodle_sso_client
OAUTH_CLIENT_SECRET=siad-hu-jz-ac-ir-super-secret-sso-key-2026-xyz

# فیلد پروفایل کد ملی در دیتابیس مودل:
NATIONAL_ID_FIELD=nationalid

# پنجره ملی خدمات دولت هوشمند (درگاه دولت من - USW):
USW_ENABLED=True
USW_CLIENT_ID=test_usw_client_id
USW_CLIENT_SECRET=test_usw_client_secret
USW_AUTHORIZE_URL=https://usw.msrt.ir/oauth2/authorize
USW_TOKEN_URL=https://usw.msrt.ir/oauth2/token
USW_USERINFO_URL=https://usw.msrt.ir/api/v1/User/userinfo
USW_REDIRECT_URI=http://localhost:8016/auth/usw/callback
USW_AUTO_CREATE_USER=True

# خط لوله احراز هویت اوراکل دانشگاه (لایه‌های ۱ و ۲ - استعلام زنده):
ORACLE_ENABLED=True
ORACLE_HOST=172.25.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=orc1
ORACLE_USER=ALIREZA_HODA
ORACLE_PASSWORD=s.harasani1377
ORACLE_SCHEMA=SHARIFI

# پیامک و کدهای یکبارمصرف (OTP):
SMS_PROVIDER=ghasedak
GHASEDAK_API_KEY=
GHASEDAK_SENDER=
SMS_DEBUG_MODE=True
OTP_TTL_SECONDS=120
OTP_COOLDOWN_SECONDS=60
SMTP_ENABLED=False

# ==============================================================================
# ۷. سامانه وبینار و کلاس آنلاین گرین‌لایت ۳ (Greenlight v3 + JoinIN BigBlueButton)
# ==============================================================================
SECRET_KEY_BASE=22e7cdfc3073eef6a239fe965bc5d1bca858c8d05a0592b5392739e3be8bdfd933ce6e7f45abbbe59bc5c9ebeec685f030b40f33fe8dd12c38d08273f13e5874

# اتصال به سرور BigBlueButton:
BIGBLUEBUTTON_ENDPOINT=https://api0.joinin.ir/jz-ac/api
BIGBLUEBUTTON_SECRET=9a7bcfc0-52fd-4f9a-a90f-aae9b6595d48

# آدرس‌ها و هاست گرین‌لایت (برای لوکال localhost:3000 و برای سرور sakoo.hu.jz.ac.ir):
URL_HOST=localhost:3000
SAFE_DOMAIN=localhost
BYPASS_HOST=true
RAILS_FORCE_SSL=false
FORCE_SSL=false

# برای سرور پروداکشن (در سرور این ۵ خط را فعال و ۵ خط بالا را کامنت کنید):
# URL_HOST=sakoo.hu.jz.ac.ir
# SAFE_DOMAIN=sakoo.hu.jz.ac.ir
# BYPASS_HOST=false
# RAILS_FORCE_SSL=true
# FORCE_SSL=true

# پایگاه داده و کش اختصاصی گرین‌لایت:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenlight-v3-production
DATABASE_URL=postgresql://postgres:postgres@greenlight-postgres:5432/greenlight-v3-production
REDIS_URL=redis://greenlight-redis:6379

# تنظیمات همگام‌سازی خودکار ضبط‌های جلسات (Recordings Sync Worker):
RECORDINGS_SYNC_INTERVAL=120
RECORDINGS_FULL_SYNC_EVERY=5

# زبان پیش‌فرض (فارسی RTL با تم هدی):
DEFAULT_LOCALE=fa
LOG_LEVEL=info
LOGGING_DRIVER=json-file
