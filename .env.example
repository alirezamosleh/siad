# ==============================================================================
# نمونه فایل متغیرهای محیطی سامانه (سیاد + گرین‌لایت + سرویس ورود یکپارچه)
# برای محیط لوکال مقادیر localhost و برای پروداکشن مقادیر دامنه را قرار دهید.
# ==============================================================================

# --- محیط اجرا (local یا production) ---
ENVIRONMENT=local

# # --- تنظیمات مودل (Moodle) ---
# # در محیط محلی:
# MOODLE_PORT=8080
# MOODLE_HOST=localhost:8080
# MOODLE_URL=http://localhost:8080
# MOODLE_REVERSEPROXY=no
# MOODLE_SSLPROXY=no

در محیط پروداکشن (نمونه):
MOODLE_PORT=8080
MOODLE_HOST=siad.hu.jz.ac.ir
MOODLE_URL=https://siad.hu.jz.ac.ir
MOODLE_REVERSEPROXY=no
MOODLE_SSLPROXY=yes

MOODLE_ADMIN_USER=admin1
MOODLE_ADMIN_PASSWORD=change_this_password
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_NAME=سامانه یادگیری سیاد

# --- تنظیمات پایگاه داده MariaDB ---
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=siad
DB_USER=alirezabb
DB_PASSWORD=SEDO3482389D4

# --- تنظیمات ردیس (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kali

# --- تنظیمات سرویس احراز هویت FastAPI ---
AUTH_PORT=8016
# AUTH_SERVICE_URL=http://localhost:8016
AUTH_SERVICE_URL=https://auth.hu.jz.ac.ir
SSO_SECRET=siad-hu-jz-ac-ir-super-secret-sso-key-2026-xyz
SSO_TOKEN_TTL_SECONDS=120

# --- تنظیمات گرین‌لایت (Greenlight v3) ---
# GREENLIGHT_PORT=3000
# GREENLIGHT_HOST=localhost:3000
# GREENLIGHT_URL=http://localhost:3000
# GREENLIGHT_SAFE_DOMAIN=localhost
# GREENLIGHT_BYPASS_HOST=true
# GREENLIGHT_FORCE_SSL=false
# در پروداکشن:
GREENLIGHT_HOST=sakoo.hu.jz.ac.ir
GREENLIGHT_URL=https://sakoo.hu.jz.ac.ir
GREENLIGHT_SAFE_DOMAIN=sakoo.hu.jz.ac.ir
GREENLIGHT_BYPASS_HOST=false
GREENLIGHT_FORCE_SSL=true

# --- تنظیمات پورت Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
